<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="drone_world">

    <!-- ==================== WORLD PLUGINS ==================== -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Simulation Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- Required for Camera, LiDAR, Barometer, and IMU sensors to publish -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- ==================== ENVIRONMENT ==================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== EMBEDDED DRONE MODEL ==================== -->
    <model name="X3">
      <pose>0 0 0.0533 0 0 0</pose>

      <!-- BASE LINK -->
      <link name="base_link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.025</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.009</iyy><iyz>0</iyz>
            <izz>0.033</izz>
          </inertia>
        </inertial>
        <collision name="base_link_collision">
          <geometry>
            <box><size>0.40 0.40 0.11</size></box>
          </geometry>
        </collision>
        <visual name="base_link_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://X3/meshes/x3.dae</uri>
            </mesh>
          </geometry>
        </visual>

        <!-- Environmental Sensors -->
        <sensor name="air_pressure" type="air_pressure">
          <always_on>1</always_on>
          <update_rate>50</update_rate>
          <air_pressure><reference_altitude>0</reference_altitude></air_pressure>
        </sensor>

        <sensor name="magnetometer" type="magnetometer">
          <always_on>1</always_on>
          <update_rate>50</update_rate>
        </sensor>

        <!-- 2D GPU LiDAR -->
        <sensor name="lidar_2d" type="gpu_lidar">
          <pose>0 0 0.3 0 0 0</pose>
          <topic>/model/X3/lidar/scan</topic>
          <always_on>1</always_on>
          <update_rate>13</update_rate>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.15</min>
              <max>20.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>

        <!-- Downward / Forward Camera -->
        <sensor name="camera_front_down" type="camera">
          <pose>-0.12 0 0 0 0.785398 3.14159</pose>
          <topic>/model/X3/camera/image</topic>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <camera name="front_down_cam">
            <horizontal_fov>1.39626</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>100</far></clip>
          </camera>
        </sensor>
      </link>

      <!-- IMU LINK & JOINT -->
      <link name="imu_link">
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          </inertia>
        </inertial>
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>400</update_rate>
          <imu><enable_orientation>0</enable_orientation></imu>
        </sensor>
      </link>
      <joint name="imu_joint" type="fixed">
        <parent>base_link</parent>
        <child>imu_link</child>
      </joint>

      <!-- ROTORS & JOINTS -->
      <!-- Rotor 0 (Front-Right, CCW) -->
      <link name="rotor_0">
        <pose>0.13 -0.22 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.17e-05</iyy><iyz>0</iyz><izz>4.26e-05</izz>
          </inertia>
        </inertial>
        <visual name="rotor_0_visual">
          <geometry>
            <mesh><scale>0.1 0.1 0.1</scale><uri>model://X3/meshes/propeller_ccw.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
      <joint name="rotor_0_joint" type="revolute">
        <child>rotor_0</child>
        <parent>base_link</parent>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- Rotor 1 (Rear-Left, CCW) -->
      <link name="rotor_1">
        <pose>-0.13 0.20 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.17e-05</iyy><iyz>0</iyz><izz>4.26e-05</izz>
          </inertia>
        </inertial>
        <visual name="rotor_1_visual">
          <geometry>
            <mesh><scale>0.1 0.1 0.1</scale><uri>model://X3/meshes/propeller_ccw.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
      <joint name="rotor_1_joint" type="revolute">
        <child>rotor_1</child>
        <parent>base_link</parent>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- Rotor 2 (Front-Left, CW) -->
      <link name="rotor_2">
        <pose>0.13 0.22 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.17e-05</iyy><iyz>0</iyz><izz>4.26e-05</izz>
          </inertia>
        </inertial>
        <visual name="rotor_2_visual">
          <geometry>
            <mesh><scale>0.1 0.1 0.1</scale><uri>model://X3/meshes/propeller_cw.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
      <joint name="rotor_2_joint" type="revolute">
        <child>rotor_2</child>
        <parent>base_link</parent>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- Rotor 3 (Rear-Right, CW) -->
      <link name="rotor_3">
        <pose>-0.13 -0.20 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.17e-05</iyy><iyz>0</iyz><izz>4.26e-05</izz>
          </inertia>
        </inertial>
        <visual name="rotor_3_visual">
          <geometry>
            <mesh><scale>0.1 0.1 0.1</scale><uri>model://X3/meshes/propeller_cw.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
      <joint name="rotor_3_joint" type="revolute">
        <child>rotor_3</child>
        <parent>base_link</parent>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- ==================== PLUGINS ==================== -->
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher" />

      <!-- Rotor 0 Lift/Drag -->
      <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
        <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma>
        <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
        <area>0.002</area><air_density>1.2041</air_density><cp>0.084 0 0</cp>
        <forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_0</link_name>
      </plugin>
      <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
        <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma>
        <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
        <area>0.002</area><air_density>1.2041</air_density><cp>-0.084 0 0</cp>
        <forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_0</link_name>
      </plugin>

      <!-- Rotor 1 Lift/Drag -->
      <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
        <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma>
        <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
        <area>0.002</area><air_density>1.2041</air_density><cp>0.084 0 0</cp>
        <forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_1</link_name>
      </plugin>
      <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
        <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma>
        <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
        <area>0.002</area><air_density>1.2041</air_density><cp>-0.084 0 0</cp>
        <forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_1</link_name>
      </plugin>

      <!-- Rotor 2 Lift/Drag -->
      <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
        <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma>
        <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
        <area>0.002</area><air_density>1.2041</air_density><cp>0.084 0 0</cp>
        <forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_2</link_name>
      </plugin>
      <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
        <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma>
        <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
        <area>0.002</area><air_density>1.2041</air_density><cp>-0.084 0 0</cp>
        <forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_2</link_name>
      </plugin>

      <!-- Rotor 3 Lift/Drag -->
      <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
        <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma>
        <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
        <area>0.002</area><air_density>1.2041</air_density><cp>0.084 0 0</cp>
        <forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_3</link_name>
      </plugin>
      <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
        <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma>
        <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
        <area>0.002</area><air_density>1.2041</air_density><cp>-0.084 0 0</cp>
        <forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_3</link_name>
      </plugin>

      <!-- Joint Force Actuators -->
      <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
        <joint_name>rotor_0_joint</joint_name>
      </plugin>
      <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
        <joint_name>rotor_1_joint</joint_name>
      </plugin>
      <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
        <joint_name>rotor_2_joint</joint_name>
      </plugin>
      <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
        <joint_name>rotor_3_joint</joint_name>
      </plugin>

      <!-- ArduPilot Bridge Plugin -->
      <plugin filename="ArduPilotPlugin" name="ArduPilotPlugin">
        <fdm_addr>127.0.0.1</fdm_addr>
        <fdm_port_in>9002</fdm_port_in>
        <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
        <lock_step>1</lock_step>
        <have_32_channels>0</have_32_channels>

        <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
        <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

        <imuName>X3::imu_link::imu_sensor</imuName>
        <have_imu>1</have_imu>
        <have_mag>1</have_mag>
        <have_pressure>1</have_pressure>
        <have_gps>0</have_gps>

        <controls>
          <control channel="0">
            <jointName>rotor_0_joint</jointName>
            <useForce>1</useForce>
            <multiplier>838</multiplier>
            <offset>0</offset>
            <servo_min>1000</servo_min>
            <servo_max>2000</servo_max>
            <type>VELOCITY</type>
            <p_gain>0.20</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0</d_gain>
            <cmd_max>20.0</cmd_max>
            <cmd_min>-20.0</cmd_min>
            <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
          </control>
          <control channel="1">
            <jointName>rotor_1_joint</jointName>
            <useForce>1</useForce>
            <multiplier>838</multiplier>
            <offset>0</offset>
            <servo_min>1000</servo_min>
            <servo_max>2000</servo_max>
            <type>VELOCITY</type>
            <p_gain>0.20</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0</d_gain>
            <cmd_max>20.0</cmd_max>
            <cmd_min>-20.0</cmd_min>
            <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
          </control>
          <control channel="2">
            <jointName>rotor_2_joint</jointName>
            <useForce>1</useForce>
            <multiplier>-838</multiplier>
            <offset>0</offset>
            <servo_min>1000</servo_min>
            <servo_max>2000</servo_max>
            <type>VELOCITY</type>
            <p_gain>0.20</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0</d_gain>
            <cmd_max>20.0</cmd_max>
            <cmd_min>-20.0</cmd_min>
            <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
          </control>
          <control channel="3">
            <jointName>rotor_3_joint</jointName>
            <useForce>1</useForce>
            <multiplier>-838</multiplier>
            <offset>0</offset>
            <servo_min>1000</servo_min>
            <servo_max>2000</servo_max>
            <type>VELOCITY</type>
            <p_gain>0.20</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0</d_gain>
            <cmd_max>20.0</cmd_max>
            <cmd_min>-20.0</cmd_min>
            <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
          </control>
        </controls>
      </plugin>
    </model>

  </world>
</sdf>
