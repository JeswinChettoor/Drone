<?xml version="1.0"?>
<robot name="robot2">

  <material name="pink"><color rgba="1.0 0.4 0.7 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>

  <!-- BASE FOOTPRINT -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- BASE LINK -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/bot_body.stl" scale="0.15 0.1 0.15"/>
      </geometry>
      <material name="pink"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/bot_body.stl" scale="0.15 0.1 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
    <visual>
      <material>
        <ambient>1.0 0.4 0.7 1</ambient>
        <diffuse>1.0 0.4 0.7 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <!-- LEFT WHEEL -->
  <joint name="joint_wheel_left" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="0 0.1875 -0.15" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_left">
    <visual>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/wheel.stl" scale="0.38 0.38 0.38"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/wheel.stl" scale="0.38 0.38 0.38"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <gazebo reference="wheel_left">
    <material>Gazebo/Black</material>
    <mu1>20.0</mu1>
    <mu2>20.0</mu2>
  </gazebo>

  <!-- RIGHT WHEEL -->
  <joint name="joint_wheel_right" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="0 -0.1875 -0.15" rpy="1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>
  <link name="wheel_right">
    <visual>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/wheel.stl" scale="0.38 0.38 0.38"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/wheel.stl" scale="0.38 0.38 0.38"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <gazebo reference="wheel_right">
    <material>Gazebo/Black</material>
    <mu1>20.0</mu1>
    <mu2>20.0</mu2>
  </gazebo>

  <!-- FRONT CASTER PART -->
  <joint name="joint_caster_part_front" type="continuous">
    <parent link="base_link"/>
    <child link="caster_part_front"/>
    <origin xyz="0.15 0 -0.15" rpy="-1.5708 0 -1.5708"/>
    <axis xyz= "0 1 0"/>
  </joint>
  <link name="caster_part_front">
    <visual>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/caster_part.stl" scale="0.3 0.3 0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/caster_part.stl" scale="0.3 0.3 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <gazebo reference="caster_part_front">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- FRONT CASTER WHEEL -->
  <joint name="joint_caster_wheel_front" type="continuous">
    <parent link="caster_part_front"/>
    <child link="caster_wheel_front"/>
    <origin xyz="0 0.044 0.018" rpy="-1.5708 0 -1.5708"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="caster_wheel_front">
    <visual>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/caster_wheel.stl" scale="0.3 0.3 0.3"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/caster_wheel.stl" scale="0.3 0.3 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <gazebo reference="caster_wheel_front">
    <mu1>20.0</mu1>
    <mu2>20.0</mu2>
  </gazebo>

  <!-- REAR CASTER PART -->
  <joint name="joint_caster_part_back" type="continuous">
    <parent link="base_link"/>
    <child link="caster_part_back"/>
    <origin xyz="-0.17 0 -0.15" rpy="-1.5708 0 -1.5708"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="caster_part_back">
    <visual>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/caster_part.stl" scale="0.3 0.3 0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/caster_part.stl" scale="0.3 0.3 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <gazebo reference="caster_part_back">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- REAR CASTER WHEEL -->
  <joint name="joint_caster_wheel_back" type="continuous">
    <parent link="caster_part_back"/>
    <child link="caster_wheel_back"/>
    <origin xyz="0 0.044 0.018" rpy="-1.5708 0 -1.5708"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="caster_wheel_back">
    <visual>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/caster_wheel.stl" scale="0.3 0.3 0.3"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/yash/noss_ws/src/maze_explorer/meshes/caster_wheel.stl" scale="0.3 0.3 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <gazebo reference="caster_wheel_back">
    <mu1>20.0</mu1>
    <mu2>20.0</mu2>
  </gazebo>

  <!-- HOLONOMIC DRONE MOVEMENT -->
  <gazebo>
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <update_rate>50</update_rate>
      <!-- These two lines guarantee the bot's location is tracked for mapping -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>
  
  <!-- LIDAR BODY-->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.03 0 0.70" rpy="0 0 0"/>
  </joint>

  <!-- LIDAR SENSOR -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize> 
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>0.5</resolution>
            <min_angle>-3.14</min_angle> 
            <max_angle>3.14</max_angle>  
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="scan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping> 
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  
  <!-- Camera Body -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.1 0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.15 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Optical Frame for ROS to read the image correctly -->
  <link name="camera_link_optical"></link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  
  <gazebo reference="camera_link">
    <material>Gazebo/Blue</material>
    <sensor type="depth" name="camera1">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/image_raw:=camera/image_raw</remapping>
          <remapping>~/depth/image_raw:=camera/depth/image_raw</remapping>
          <remapping>~/points:=camera/points</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link_optical</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
</robot>
